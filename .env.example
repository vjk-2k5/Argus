# Configure any providers you want Argus to expose.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
ARGUS_OPENAI_COMPATIBLE_API_KEY=
ARGUS_OPENAI_COMPATIBLE_BASE_URL=
# AWS Bedrock. The API key authenticates with a bearer token and takes precedence over SigV4.
# AWS_REGION is required in addition to the key, since Bedrock models are region-scoped.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Optional comma-separated model overrides.
ARGUS_OPENAI_MODELS=gpt-5,gpt-4.1
ARGUS_ANTHROPIC_MODELS=claude-sonnet-4-5,claude-opus-4-1
ARGUS_GOOGLE_MODELS=gemini-2.5-pro,gemini-2.5-flash
ARGUS_OPENROUTER_MODELS=openai/gpt-5,anthropic/claude-sonnet-4.5
ARGUS_BEDROCK_MODELS=us.anthropic.claude-sonnet-4-5-20250929-v1:0,us.amazon.nova-pro-v1:0
# Optional. Picks the single Bedrock model Argus defaults to, ahead of ARGUS_BEDROCK_MODELS.
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

ARGUS_PORT=3001
ARGUS_DATABASE_PATH=./argus.db
ARGUS_CONTEXT_WINDOW=128000
ARGUS_COMPACTION_RESERVED_TOKENS=20000
# Optional shell for the bash tool. Unset, Argus auto-detects: on Windows PowerShell 7, then
# Windows PowerShell 5.1, then Git Bash, then cmd.exe; on POSIX $SHELL, then bash. Models write
# POSIX syntax by default, so on Windows pointing this at Git Bash is usually the best fit.
# ARGUS_SHELL=
# ARGUS_GIT_BASH_PATH=
# Optional ceilings. Both are unset by default, so an agent works as long as it needs and the
# provider applies the model's own output maximum.
# ARGUS_MAX_OUTPUT_TOKENS=32000
# ARGUS_MAX_STEPS=24

# Phase 2: agent tools.
# Root directory for the per-session workspace each debate gets.
ARGUS_SESSIONS_DIR=C:/Projects/Argus_Sessions
# How many times a turn cut off by a limit is resumed in place, before the round is treated as
# settled. 0 makes any cut turn count as finished.
ARGUS_MAX_CONTINUATIONS=2
# Web search backend: exa (keyless, returns full page content), duckduckgo, tavily, or brave.
# Failed providers fall through to the next one, so websearch never hard-fails.
ARGUS_SEARCH_PROVIDER=exa
# Optional. Lifts Exa's free-tier rate and result limits.
EXA_API_KEY=
ARGUS_TAVILY_API_KEY=
ARGUS_BRAVE_API_KEY=
